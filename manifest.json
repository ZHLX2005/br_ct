{
  "manifest_version": 3,
  "name": "AI Assistant",
  "version": "1.5.0",
  "description": "多端AI调度工具，支持Yuanbao和Gemini",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/main/main.html",
    "default_title": "AI Assistant"
  },
  "side_panel": {
    "default_path": "sidebar/main/main.html"
  },
  "options_ui": {
    "page": "/options/options.html",
    "open_in_tab": true
},
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "notifications",
    "commands",
    "downloads",
    "alarms",
    "clipboardRead",
    "history",
    "contextMenus",
    "bookmarks",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle_sidebar": {
      "suggested_key": { "default": "Alt+S" },
      "description": "打开/关闭 AI 助手边栏"
    },
    "add_to_workspace": {
      "suggested_key": { "default": "Alt+W" },
      "description": "快速添加当前页面到工作区"
    },
    "execute_div_copy": {
      "suggested_key": { "default": "Alt+C" },
      "description": "执行 div Copy 脚本"
    },
    "imgs_picker": {
      "suggested_key": { "default": "Alt+D" },
      "description": "执行 div Copy 脚本"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "runjs/translation/lib/marked.min.js",
        "runjs/translation/lib/katex.min.js",
        "runjs/translation/content.js",
        "runjs/translation/selection-ask.js",
        "runjs/translation/content-ocr.js",
        "runjs/sidebar/sidebar-selection-content.js",
        "runjs/sidebar/sidebar-tab-switch.js"
      ],
      "css": [
        "runjs/translation/content.css",
        "runjs/translation/selection-ask.css",
        "runjs/translation/content-ocr.css",
        "runjs/translation/lib/katex.min.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://yuanbao.tencent.com/*",
        "*://chat.deepseek.com/*",
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://www.doubao.com/*",
        "*://chatglm.cn/*",
        "*://aistudio.google.com/*",
        "*://gemini.google.com/*",
        "*://*.qianwen.com/*",
        "*://grok.com/*",
        "*://www.notion.so/*",
        "*://app.notion.com/*",
        "*://chat.z.ai/*",
        "*://www.kimi.com/*",
        "*://coder.qwen.ai/*",
        "*://www.coze.cn/*",
        "*://aistudio.xiaomimimo.com/*",
        "*://copilot.microsoft.com/*"
      ],
      "js": ["contentScripts/nav/entry.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "contentScripts/*.js",
        "config/*.js",
        "funcs/*.js",
        "runjs/*.js",
        "runjs/*.css",
        "modules/translation/*.js",
        "modules/translation/*.html",
        "popup/*.html",
        "popup/**/*.html",
        "popup/**/*.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
